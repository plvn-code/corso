# CORSO Telegram bot (create it in @BotFather). Without these, orders and chat requests are only logged.
TELEGRAM_BOT_TOKEN=
# Managers' chat / group id (add the bot to the group) — orders, chat requests and client messages go here
TELEGRAM_CHAT_ID=
# Random string; pass it as secret_token to setWebhook (see docs/STATUS.md → Telegram-бот)
TELEGRAM_WEBHOOK_SECRET=
# Bot username without @ — adds «open in Telegram» to the on-site chat
NEXT_PUBLIC_TELEGRAM_BOT=
# Set to true at launch (noindex until then)
NEXT_PUBLIC_ALLOW_INDEXING=
NEXT_PUBLIC_SITE_URL=
